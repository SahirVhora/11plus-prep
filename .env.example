# Frontend - set this GitHub Actions repository variable after deploying the API.
VITE_AI_API_URL=https://your-secure-api.example.com

# Server-only provider credentials. Never prefix these with VITE_.
WORKSHEET_ACCESS_CODE=choose-a-long-private-family-code
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=

# Optional comma-separated additions to the built-in GitHub Pages/local origins.
ALLOWED_ORIGINS=
